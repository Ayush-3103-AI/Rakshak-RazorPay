# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Data (generator output, downloads) — manifests only, per CLAUDE.md.
# git does not descend into an excluded directory, so each level must be
# re-included explicitly before a negation inside it can match (T-0015).
data/*
!data/external/
data/external/*
!data/external/*.manifest.json

# Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
